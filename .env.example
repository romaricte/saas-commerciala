NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_commerciale

# Générez chacun de ces secrets indépendamment avec au moins 32 octets aléatoires.
JWT_SECRET=replace-with-a-long-random-secret-for-local-dev-1234567890
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-for-local-dev-1234567890
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
AUTH_TOKEN_PEPPER=replace-with-a-third-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800
INVITATION_TTL_SECONDS=604800

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SaaS Commerciale <no-reply@example.com>
