generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  USER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum CatalogItemType {
  PRODUCT
  SERVICE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum DocumentType {
  QUOTE
  ORDER
  INVOICE
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  FULFILLED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHECK
  MOBILE_MONEY
  OTHER
}

model Tenant {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique
  status TenantStatus @default(TRIAL)
  plan   String       @default("basic")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  clients     Client[]
  products    Product[]
  roles       Role[]
  invitations UserInvitation[]
  auditLogs   AuditLog[]
  quotes      Quote[]
  orders      SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]
  sequences   DocumentSequence[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")

  emailVerifiedAt   DateTime? @map("email_verified_at")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  lastLoginAt       DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Un SUPER_ADMIN de plateforme peut ne pas appartenir à un tenant.
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sessions             AuthSession[]
  authTokens           AuthToken[]
  roleAssignments      UserRoleAssignment[]   @relation("UserAssignedRoles")
  rolesAssigned        UserRoleAssignment[]   @relation("RoleAssignedBy")
  sentInvitations      UserInvitation[]       @relation("InvitationInviter")
  auditLogs            AuditLog[]             @relation("AuditActor")
  createdQuotes        Quote[]                @relation("QuoteCreator")
  quoteStatusChanges   QuoteStatusHistory[]   @relation("QuoteStatusActor")
  createdOrders        SalesOrder[]           @relation("OrderCreator")
  orderStatusChanges   OrderStatusHistory[]   @relation("OrderStatusActor")
  createdInvoices      Invoice[]              @relation("InvoiceCreator")
  invoiceStatusChanges InvoiceStatusHistory[] @relation("InvoiceStatusActor")
  recordedPayments     Payment[]              @relation("PaymentRecorder")
  reversedPayments     Payment[]              @relation("PaymentReverser")

  @@index([tenantId])
  @@map("users")
}

/// Catalogue global des actions autorisables. Les clés sont stables et
/// utilisées dans les décorateurs @RequirePermissions().
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique @db.VarChar(100)
  name        String  @db.VarChar(120)
  description String? @db.VarChar(500)
  resource    String  @db.VarChar(60)
  action      String  @db.VarChar(60)

  roleAssignments RolePermission[]

  @@index([resource])
  @@map("permissions")
}

/// Un rôle appartient à un seul tenant. Les rôles système sont provisionnés
/// automatiquement et ne peuvent pas être modifiés via l'API.
model Role {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(80)
  description String?   @db.VarChar(500)
  rank        Int       @default(1)
  isSystem    Boolean   @default(false) @map("is_system")
  systemRole  UserRole? @map("system_role")

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  permissions     RolePermission[]
  users           UserRoleAssignment[]
  invitationRoles InvitationRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@unique([tenantId, systemRole])
  @@index([tenantId, rank])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId       String  @map("user_id")
  roleId       String  @map("role_id")
  assignedById String? @map("assigned_by_id")

  user       User  @relation("UserAssignedRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_role_assignments")
}

/// Une invitation est une preuve temporaire permettant au collaborateur de
/// choisir lui-même son mot de passe. Seule l'empreinte du token est stockée.
model UserInvitation {
  id          String @id @default(cuid())
  email       String
  firstName   String @map("first_name") @db.VarChar(80)
  lastName    String @map("last_name") @db.VarChar(80)
  tokenHash   String @unique @map("token_hash") @db.VarChar(64)
  tenantId    String @map("tenant_id")
  invitedById String @map("invited_by_id")

  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User             @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  roles     InvitationRole[]

  @@index([tenantId, email])
  @@index([expiresAt])
  @@map("user_invitations")
}

model InvitationRole {
  invitationId String @map("invitation_id")
  roleId       String @map("role_id")

  invitation UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role       Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([invitationId, roleId])
  @@index([roleId])
  @@map("invitation_roles")
}

/// Journal append-only des changements d'identité et d'autorisation.
model AuditLog {
  id          String  @id @default(cuid())
  action      String  @db.VarChar(100)
  targetType  String  @map("target_type") @db.VarChar(60)
  targetId    String? @map("target_id")
  metadata    Json?
  tenantId    String  @map("tenant_id")
  actorUserId String? @map("actor_user_id")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// Une session représente un appareil connecté. Sa révocation invalide
/// immédiatement l'access token lors du passage dans JwtAuthGuard.
model AuthSession {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  userAgent String? @map("user_agent") @db.VarChar(512)
  ipAddress String? @map("ip_address") @db.VarChar(64)

  expiresAt     DateTime  @map("expires_at")
  lastUsedAt    DateTime  @default(now()) @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason") @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Chaque rotation crée un nouveau refresh token. Le token brut n'est jamais
/// persisté : seule son empreinte HMAC est conservée.
model RefreshToken {
  id        String @id
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  sessionId String @map("session_id")

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Jeton opaque à usage unique pour les flux hors session.
model AuthToken {
  id        String        @id @default(cuid())
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.VarChar(64)
  userId    String        @map("user_id")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Client {
  id      String  @id @default(cuid())
  name    String
  email   String?
  phone   String?
  address String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantId String       @map("tenant_id")
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes   Quote[]
  orders   SalesOrder[]
  invoices Invoice[]

  @@index([tenantId])
  @@map("clients")
}

model Product {
  id          String          @id @default(cuid())
  type        CatalogItemType @default(PRODUCT)
  name        String          @db.VarChar(160)
  description String?         @db.Text
  sku         String?         @db.VarChar(80)
  unit        String          @default("unit") @db.VarChar(30)
  salePrice   Decimal         @map("sale_price") @db.Decimal(14, 2)
  costPrice   Decimal?        @map("cost_price") @db.Decimal(14, 2)
  taxRate     Decimal         @default(0) @map("tax_rate") @db.Decimal(5, 2)
  currency    String          @default("XOF") @db.Char(3)
  archivedAt  DateTime?       @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantId     String           @map("tenant_id")
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quoteLines   QuoteLine[]
  orderLines   SalesOrderLine[]
  invoiceLines InvoiceLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, type, archivedAt])
  @@index([tenantId, name])
  @@map("products")
}

/// Compteur transactionnel par tenant, type de document et année.
/// Il garantit l'unicité des numéros même avec plusieurs requêtes concurrentes.
model DocumentSequence {
  tenantId     String       @map("tenant_id")
  documentType DocumentType @map("document_type")
  year         Int
  nextValue    Int          @default(1) @map("next_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, documentType, year])
  @@map("document_sequences")
}

model Quote {
  id            String      @id @default(cuid())
  number        String      @db.VarChar(40)
  status        QuoteStatus @default(DRAFT)
  version       Int         @default(1)
  issueDate     DateTime    @map("issue_date") @db.Date
  validUntil    DateTime    @map("valid_until") @db.Date
  currency      String      @default("XOF") @db.Char(3)
  notes         String?     @db.Text
  terms         String?     @db.Text
  subtotal      Decimal     @db.Decimal(14, 2)
  discountTotal Decimal     @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal      Decimal     @default(0) @map("tax_total") @db.Decimal(14, 2)
  total         Decimal     @db.Decimal(14, 2)

  tenantId    String  @map("tenant_id")
  clientId    String  @map("client_id")
  createdById String? @map("created_by_id")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy User?                @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines     QuoteLine[]
  history   QuoteStatusHistory[]
  order     SalesOrder?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, clientId])
  @@map("quotes")
}

/// Instantané commercial : les champs ne dépendent pas des modifications
/// futures du catalogue. productId reste facultatif pour les lignes libres.
model QuoteLine {
  id            String  @id @default(cuid())
  position      Int
  label         String  @db.VarChar(160)
  description   String? @db.Text
  sku           String? @db.VarChar(80)
  unit          String  @db.VarChar(30)
  quantity      Decimal @db.Decimal(12, 3)
  unitPrice     Decimal @map("unit_price") @db.Decimal(14, 2)
  discountRate  Decimal @default(0) @map("discount_rate") @db.Decimal(5, 2)
  taxRate       Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  subtotal      Decimal @db.Decimal(14, 2)
  discountTotal Decimal @map("discount_total") @db.Decimal(14, 2)
  taxTotal      Decimal @map("tax_total") @db.Decimal(14, 2)
  total         Decimal @db.Decimal(14, 2)

  quoteId   String  @map("quote_id")
  productId String? @map("product_id")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([quoteId, position])
  @@index([productId])
  @@map("quote_lines")
}

model QuoteStatusHistory {
  id          String       @id @default(cuid())
  fromStatus  QuoteStatus? @map("from_status")
  toStatus    QuoteStatus  @map("to_status")
  comment     String?      @db.VarChar(500)
  quoteId     String       @map("quote_id")
  changedById String?      @map("changed_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  quote     Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  changedBy User? @relation("QuoteStatusActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([quoteId, createdAt])
  @@index([changedById])
  @@map("quote_status_history")
}

model SalesOrder {
  id                   String      @id @default(cuid())
  number               String      @db.VarChar(40)
  status               OrderStatus @default(DRAFT)
  version              Int         @default(1)
  orderDate            DateTime    @map("order_date") @db.Date
  expectedDeliveryDate DateTime?   @map("expected_delivery_date") @db.Date
  currency             String      @default("XOF") @db.Char(3)
  notes                String?     @db.Text
  subtotal             Decimal     @db.Decimal(14, 2)
  discountTotal        Decimal     @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal             Decimal     @default(0) @map("tax_total") @db.Decimal(14, 2)
  total                Decimal     @db.Decimal(14, 2)

  tenantId    String  @map("tenant_id")
  clientId    String  @map("client_id")
  quoteId     String? @unique @map("quote_id")
  createdById String? @map("created_by_id")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  quote     Quote?               @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy User?                @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines     SalesOrderLine[]
  history   OrderStatusHistory[]
  invoice   Invoice?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, clientId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id            String  @id @default(cuid())
  position      Int
  label         String  @db.VarChar(160)
  description   String? @db.Text
  sku           String? @db.VarChar(80)
  unit          String  @db.VarChar(30)
  quantity      Decimal @db.Decimal(12, 3)
  unitPrice     Decimal @map("unit_price") @db.Decimal(14, 2)
  discountRate  Decimal @default(0) @map("discount_rate") @db.Decimal(5, 2)
  taxRate       Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  subtotal      Decimal @db.Decimal(14, 2)
  discountTotal Decimal @map("discount_total") @db.Decimal(14, 2)
  taxTotal      Decimal @map("tax_total") @db.Decimal(14, 2)
  total         Decimal @db.Decimal(14, 2)

  orderId   String  @map("order_id")
  productId String? @map("product_id")

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([orderId, position])
  @@index([productId])
  @@map("sales_order_lines")
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  comment     String?      @db.VarChar(500)
  orderId     String       @map("order_id")
  changedById String?      @map("changed_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User?      @relation("OrderStatusActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedById])
  @@map("order_status_history")
}

model Invoice {
  id            String        @id @default(cuid())
  number        String?       @db.VarChar(40)
  status        InvoiceStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  version       Int           @default(1)
  invoiceDate   DateTime      @map("invoice_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  currency      String        @default("XOF") @db.Char(3)
  notes         String?       @db.Text
  terms         String?       @db.Text
  subtotal      Decimal       @db.Decimal(14, 2)
  discountTotal Decimal       @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal      Decimal       @default(0) @map("tax_total") @db.Decimal(14, 2)
  total         Decimal       @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  balanceDue    Decimal       @map("balance_due") @db.Decimal(14, 2)
  issuedAt      DateTime?     @map("issued_at")
  voidedAt      DateTime?     @map("voided_at")
  voidReason    String?       @map("void_reason") @db.VarChar(500)

  tenantId    String  @map("tenant_id")
  clientId    String  @map("client_id")
  orderId     String? @unique @map("order_id")
  createdById String? @map("created_by_id")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  order     SalesOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?                  @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines     InvoiceLine[]
  history   InvoiceStatusHistory[]
  payments  Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, number])
  @@index([tenantId, status, paymentStatus, createdAt])
  @@index([tenantId, clientId])
  @@index([tenantId, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id            String  @id @default(cuid())
  position      Int
  label         String  @db.VarChar(160)
  description   String? @db.Text
  sku           String? @db.VarChar(80)
  unit          String  @db.VarChar(30)
  quantity      Decimal @db.Decimal(12, 3)
  unitPrice     Decimal @map("unit_price") @db.Decimal(14, 2)
  discountRate  Decimal @default(0) @map("discount_rate") @db.Decimal(5, 2)
  taxRate       Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  subtotal      Decimal @db.Decimal(14, 2)
  discountTotal Decimal @map("discount_total") @db.Decimal(14, 2)
  taxTotal      Decimal @map("tax_total") @db.Decimal(14, 2)
  total         Decimal @db.Decimal(14, 2)

  invoiceId String  @map("invoice_id")
  productId String? @map("product_id")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, position])
  @@index([productId])
  @@map("invoice_lines")
}

model InvoiceStatusHistory {
  id          String         @id @default(cuid())
  fromStatus  InvoiceStatus? @map("from_status")
  toStatus    InvoiceStatus  @map("to_status")
  comment     String?        @db.VarChar(500)
  invoiceId   String         @map("invoice_id")
  changedById String?        @map("changed_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("InvoiceStatusActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([invoiceId, createdAt])
  @@index([changedById])
  @@map("invoice_status_history")
}

model Payment {
  id             String        @id @default(cuid())
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  paidAt         DateTime      @map("paid_at")
  reference      String?       @db.VarChar(120)
  notes          String?       @db.VarChar(500)
  reversedAt     DateTime?     @map("reversed_at")
  reversalReason String?       @map("reversal_reason") @db.VarChar(500)

  tenantId     String  @map("tenant_id")
  invoiceId    String  @map("invoice_id")
  recordedById String? @map("recorded_by_id")
  reversedById String? @map("reversed_by_id")

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User?   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  reversedBy User?   @relation("PaymentReverser", fields: [reversedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, paidAt])
  @@index([invoiceId, reversedAt])
  @@index([recordedById])
  @@index([reversedById])
  @@map("payments")
}
